# Copy to secrets.toml (local) or paste into Streamlit Cloud → Settings → Secrets
# Add at least ONE free hosted key — Ollama does NOT work on Streamlit Cloud.

# ⭐ Recommended — fastest free tier
GROQ_API_KEY = "gsk_your_groq_key_here"

# Free backups (add any/all)
# GEMINI_API_KEY = "your_gemini_key"       # https://aistudio.google.com/apikey
# HF_TOKEN = "hf_your_token"               # https://huggingface.co/settings/tokens
# TOGETHER_API_KEY = "your_together_key"   # https://api.together.xyz

# Local only — do not use on Streamlit Cloud
# ENABLE_OLLAMA = "true"